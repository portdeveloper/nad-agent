# Native, per-platform — each machine runs its own `npm install`. NEVER commit this.
node_modules/

# Build output (regenerated by `npm run build`)
dist/

# Secrets & machine-specific config. Commit .env.example, never .env.
.env
.env.local

# Model weights — downloaded per-machine (registry on fast hosts; fetch-model on slow ones)
models/
*.gguf

# Address book — your contacts (who you pay). The default lives in ~/.nad-agent/,
# but ignore a repo-local one too so it never gets committed.
addressbook.json
address-book.json

# OS / editor
.DS_Store
*.log
