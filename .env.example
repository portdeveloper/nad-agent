# Copy to .env and fill in.  ->  cp .env.example .env
# Loaded automatically by `npm start` via Node's native --env-file. Never commit .env.

# ─── Wallet (self-custodial) ──────────────────────────────────────────────────
# 24-word BIP-39 seed phrase. The agent's wallet is derived from this and the key
# NEVER leaves this machine. Generate one with:  npm run gen-seed
WDK_SEED=

# ─── Network ─────────────────────────────────────────────────────────────────
# "testnet" (default, chainId 10143) or "mainnet" (143).
MONAD_NETWORK=testnet
# Optional RPC override (defaults to the public Monad RPC for the network).
# MONAD_RPC_URL=

# ─── Gasless (ERC-4337 via Pimlico) ──────────────────────────────────────────
# OPTIONAL. Leave blank to run in DRY-RUN mode: the full agent loop works (the model
# tool-calls, you confirm), but sends are simulated instead of broadcast. Reads
# (address, balance) are always real. Set this to broadcast real transactions.
#   Get a key: https://dashboard.pimlico.io
PIMLICO_API_KEY=
# Set a sponsorship policy id (sp_...) for TRULY GASLESS sends (policy funds gas,
# the agent pays 0). Without it, sends fall back to you-pay-gas in native MON.
PIMLICO_SPONSORSHIP_POLICY_ID=
# Force a gas mode, overriding the auto-detection above:
#   dry-run    -> never broadcast, always simulate (good for dev)
#   native     -> you-pay-gas even if a sponsorship policy is set
#   sponsored  -> use the key's default policy (no explicit id)
# WDK_GAS_MODE=

# ─── Local AI brain (QVAC) ───────────────────────────────────────────────────
# Which local model to run — a ChatML instruct model runs great fully on-device.
#   name from @qvac/sdk/models, e.g. QWEN3_8B_INST_Q4_K_M (recommended) or SMOLLM2_360M_INST_Q8 (tiny dev)
QVAC_MODEL=QWEN3_8B_INST_Q4_K_M
# OR load a local .gguf directly (bypasses the P2P registry + its 60s timeout on slow hosts).
# Set this to an absolute path and it takes precedence over QVAC_MODEL.  See: npm run fetch-model
# QVAC_MODEL_PATH=/abs/path/to/model.gguf
# Context window.
QVAC_CTX_SIZE=8192
# Max tokens the model may generate per turn (llama.cpp n_predict). Caps runaway
# generation so a small model can't overflow the context. -1 = unbounded.
QVAC_MAX_TOKENS=256

# Optional: where the address book lives. Default is address-book.json beside the package.
# NAD_ADDRESS_BOOK=/path/to/address-book.json
